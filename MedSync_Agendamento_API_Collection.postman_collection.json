{
  "info": {
    "name": "MedSync - Agendamento API",
    "description": "Coleção da API de Agendamento do MedSync com todos os endpoints atualizados.\n\n🔄 FLUXO ATUALIZADO:\n1. Criar Paciente (POST /pacientes) - OBRIGATÓRIO\n2. Criar Consulta (POST /consultas) - Usa paciente pré-cadastrado\n\n⚠️ IMPORTANTE: Pacientes devem ser criados explicitamente antes de agendar consultas!",
    "version": "2.1.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "usuario_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "paciente_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "medico_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "consulta_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "especialidade_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔄 Fluxo Completo - Paciente + Consulta",
      "item": [
        {
          "name": "1. Criar Paciente (OBRIGATÓRIO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Santos\",\n  \"cpf\": \"98765432100\",\n  \"email\": \"maria.santos@email.com\",\n  \"dataNascimento\": \"1985-05-15\",\n  \"observacoes\": \"Paciente para teste do fluxo completo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/pacientes",
              "host": ["{{base_url}}"],
              "path": ["pacientes"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const responseJson = pm.response.json();",
                  "    if (responseJson.id) {",
                  "        pm.collectionVariables.set('paciente_id', responseJson.id);",
                  "        console.log('✅ Paciente criado com ID:', responseJson.id);",
                  "    }",
                  "} else {",
                  "    console.log('❌ Erro ao criar paciente:', pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "2. Criar Consulta (Usa Paciente Criado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pacienteId\": \"{{paciente_id}}\",\n  \"medicoId\": \"{{medico_id}}\",\n  \"especialidadeId\": \"{{especialidade_id}}\",\n  \"dataHora\": \"2024-12-25T14:30:00\",\n  \"observacoes\": \"Consulta de rotina - fluxo completo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/consultas",
              "host": ["{{base_url}}"],
              "path": ["consultas"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.id) {",
                  "        pm.collectionVariables.set('consulta_id', response.id);",
                  "        console.log('✅ Consulta criada com ID:', response.id);",
                  "    }",
                  "} else {",
                  "    console.log('❌ Erro ao criar consulta:', pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "3. ❌ Teste de Erro - Consulta sem Paciente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pacienteId\": \"paciente-inexistente\",\n  \"medicoId\": \"{{medico_id}}\",\n  \"especialidadeId\": \"{{especialidade_id}}\",\n  \"dataHora\": \"2024-12-25T14:30:00\",\n  \"observacoes\": \"Esta consulta deve falhar\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/consultas",
              "host": ["{{base_url}}"],
              "path": ["consultas"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 500) {",
                  "    console.log('✅ Erro esperado - Paciente não encontrado:', pm.response.text());",
                  "} else {",
                  "    console.log('❌ Erro inesperado:', pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
